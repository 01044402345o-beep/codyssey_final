rules_version = '2';
// 계정 기록은 users/{uid} 하나. 그 uid 의 토큰만 읽고 쓴다.
// 익명 로그인은 기록을 만들지 못한다. 그 밖 경로는 모두 막는다.
// 서버는 서비스 계정 없이 사용자 ID 토큰을 그대로 넘긴다.
// 쓰는 필드는 backend/app/user_state.py 의 encode_document 와 같아야 한다. 여기 없는 필드를 쓰면 거부된다.
// session·weak·consent 는 필수(문자열), trip 은 선택(있으면 문자열)이다.
//   - trip 을 선택으로 두는 이유: 규칙을 백엔드보다 먼저 배포해도 옛 백엔드(3필드)의 쓰기가 막히지 않는다.
//     무조건 요구하면 trip 을 쓰지 않는 서버의 PUT /user/state 가 PERMISSION_DENIED 가 된다.
//   - trip 을 넣는 백엔드와 화면은 별도 커밋이다. 규칙 단독 배포는 안전하고, 둘이 함께 올라가면 여행 저장이 켜진다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function signedIn() {
        return request.auth != null
          && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.keys().hasOnly(['session', 'weak', 'consent', 'trip'])
        && request.resource.data.session is string
        && request.resource.data.weak is string
        && request.resource.data.consent is string
        && (!('trip' in request.resource.data) || request.resource.data.trip is string)
        && request.resource.size() < 120000;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
