--- a/mockup/styles.css
+++ b/mockup/styles.css
@@ -1071,3 +1071,29 @@
 .pframe .tl-day .pl div { flex-wrap: wrap; }
 .admin-shell .filters { flex-wrap: wrap; }
 .admin-shell .adm-head > div:last-child { flex: 1 1 auto !important; flex-wrap: wrap; justify-content: flex-end; }   /* 인라인 flex:none 을 덮는다 */
+
+/* ============ 세로가 짧은 화면 (가로 모드 폰) ============
+   높이 375~440px 에서는 .flip 이 뷰포트의 82~100% 를 차지하고, 폭 600px 이상에서
+   내비게이션이 좌측 레일이 되면 하단 고정 바가 바닥에 남아 토스트와 겹친다.
+   폭 기준 규칙은 그대로 두고 높이 기준으로만 줄인다. */
+@media (max-height: 560px) {
+
+  /* 학습 카드. 내용은 .face 안에서 스크롤되므로 높이를 낮춰도 잘리지 않는다.
+     하한 14rem 은 브라우저 글자 확대에서도 카드가 뭉개지지 않게 남긴 값이다. */
+  .pframe .flip { height: max(clamp(200px, 46dvh, 340px), 14rem); }
+
+  /* 본문·앱바·고정 바 여백을 높이에 맞춰 줄인다 */
+  .pframe .app-pad { padding-bottom: 16px; }
+  .pframe .appbar { padding-bottom: 6px; }
+  .pframe .bottombar { padding-top: 8px; }
+  .pframe.has-nav .bottombar { padding-bottom: 8px; }
+
+  /* 토스트를 하단 고정 바(높이 약 64~71px) 위로 올린다.
+     폭 600px 이상이면 basic 규칙이 bottom:24px 로 내리는데, 가로 모드에서는
+     내비게이션이 좌측 레일이라 바가 바닥에 그대로 남아 서로 겹친다. */
+  html:not([data-mode=legacy]) .toast { bottom: calc(var(--nav-h) + 20px); }
+
+  /* 로그인 화면 */
+  .pframe .login h1 { margin-top: clamp(24px, 10dvh, 72px); }
+  .pframe .login .stamp { width: clamp(96px, 26dvh, 150px); height: clamp(96px, 26dvh, 150px); }
+}
