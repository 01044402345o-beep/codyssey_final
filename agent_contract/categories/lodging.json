{
  "category_id": "lodging",
  "category": "숙소·호텔",
  "owner": "함명자",
  "place_types": ["hotel", "hostel", "guesthouse", "airbnb"],

  "rules": {
    "min_sentences_per_situation": 1,
    "max_sentences_per_situation": 3,
    "max_words_per_sentence": 15,
    "min_sentences_per_category": 8,
    "tone": "polite"
  },

  "situations": [
    { "situation_id": "check_in",          "situation": "체크인·예약 확인",
      "required_keywords": ["check in", "reservation"] },
    { "situation_id": "leave_luggage",     "situation": "수하물 맡기기",
      "required_keywords": ["luggage", "baggage", "keep", "store"] },
    { "situation_id": "room_upgrade",      "situation": "객실 업그레이드 문의" },
    { "situation_id": "ask_breakfast",     "situation": "조식 시간·위치 질문",
      "required_keywords": ["breakfast"] },
    { "situation_id": "ask_wifi",          "situation": "와이파이 비밀번호 요청" },
    { "situation_id": "early_late_check",  "situation": "얼리 체크인·레이트 체크아웃" },
    { "situation_id": "request_amenity",   "situation": "수건·어메니티 추가 요청",
      "required_keywords": ["towel", "water"] },
    { "situation_id": "order_room_service","situation": "룸서비스 주문" },
    { "situation_id": "room_complaint",    "situation": "객실 문제(청소·소음) 컴플레인" },
    { "situation_id": "check_out",         "situation": "체크아웃·비용 정산",
      "required_keywords": ["check out", "bill", "pay"] }
  ],

  "system_prompt": "You generate travel English practice sentences for the 'lodging / hotel' category.\n\nINPUT: city, a list of places (place_type in [hotel, hostel, guesthouse, airbnb]), the situation list, and the learner's weak situations.\n\nRULES:\n- Output ONLY JSON matching the attached schema. No prose, no markdown fences.\n- Generate between {min_sentences_per_situation} and {max_sentences_per_situation} sentences for each situation_id.\n- English: polite register, at most {max_words_per_sentence} words, immediately usable on the spot.\n- Korean: natural translation, not word-for-word.\n- If a weak situation is given, it MUST have at least one sentence, and that sentence must contain the situation's required_keywords (e.g. leave_luggage -> luggage/baggage).\n- Do NOT encourage drinking, or raise politics or religion.\n- Never repeat the same English sentence across situations.\n- When a specific place is given, reference its feature where natural.",

  "good_examples": [
    {
      "place": "Hilton Hotel",
      "place_type": "hotel",
      "situation_id": "check_in",
      "situation": "체크인·예약 확인",
      "en": "I'd like to check in. My reservation is under Kim.",
      "ko": "체크인하고 싶습니다. 김으로 예약했어요.",
      "level": "basic",
      "tags": ["체크인", "예약"]
    },
    {
      "place": "Local Hostel",
      "place_type": "hostel",
      "situation_id": "leave_luggage",
      "situation": "수하물 맡기기",
      "en": "Could you keep my luggage until check-in?",
      "ko": "체크인할 때까지 짐을 좀 맡아주실 수 있나요?",
      "level": "basic",
      "tags": ["수하물", "서비스"],
      "targets_weak": ["leave_luggage"]
    },
    {
      "place": "Airbnb",
      "place_type": "airbnb",
      "situation_id": "ask_wifi",
      "situation": "와이파이 비밀번호 요청",
      "en": "What is the Wi-Fi password?",
      "ko": "와이파이 비밀번호가 어떻게 되나요?",
      "level": "basic",
      "tags": ["와이파이"]
    }
  ],

  "negative_cases": [
    {
      "case_id": "forbidden_topic",
      "why": "음주 권유·정치 화제",
      "expect": "forbidden_topic",
      "sentence": {
        "place_type": "hotel",
        "situation_id": "check_in",
        "situation": "체크인·예약 확인",
        "en": "Let's grab a beer and talk about politics.",
        "ko": "맥주 마시면서 정치 얘기 합시다."
      }
    },
    {
      "case_id": "place_mismatch",
      "why": "카테고리에 없는 상황 (숙소인데 식당 메뉴 주문)",
      "expect": "situation_not_in_config",
      "sentence": {
        "place_type": "hotel",
        "situation_id": "order_menu",
        "situation": "대표 메뉴 주문",
        "en": "I'd like a pastrami sandwich, please.",
        "ko": "파스트라미 샌드위치 하나 주세요."
      }
    },
    {
      "case_id": "too_long",
      "why": "15단어 초과",
      "expect": "too_long",
      "sentence": {
        "place_type": "hotel",
        "situation_id": "leave_luggage",
        "situation": "수하물 맡기기",
        "en": "Excuse me, I was wondering if it might be possible for you to kindly keep my luggage here.",
        "ko": "실례합니다, 혹시 제 짐을 여기에 친절하게 보관해주실 수 있는지 궁금합니다."
      }
    },
    {
      "case_id": "duplicate",
      "why": "같은 팩 안에서 영문 중복",
      "expect": "duplicate_en",
      "sentence": {
        "place_type": "hotel",
        "situation_id": "ask_wifi",
        "situation": "와이파이 비밀번호 요청",
        "en": "What is the Wi-Fi password?",
        "ko": "와이파이 비밀번호가 어떻게 되나요?"
      }
    },
    {
      "case_id": "not_polite",
      "why": "명령조",
      "expect": "not_polite",
      "sentence": {
        "place_type": "hotel",
        "situation_id": "request_amenity",
        "situation": "수건·어메니티 추가 요청",
        "en": "Gimme some towels right now.",
        "ko": "당장 수건 좀 줘."
      }
    }
  ],

  "negative_case_patterns": {
    "_note": "terms 는 소문자 기준 부분일치. '행위·태도'만 넣고 명사(beer, wine)나 'now' 같은 일반어는 넣지 말 것 — 정상 문장을 막는다. severity=block 은 재생성, warn 은 검토 대상.",
    "forbidden_topic": {
      "severity": "block",
      "match": "substring",
      "terms": ["let's drink", "let's get drunk", "you should drink", "get drunk", "talk about politics", "about religion"]
    },
    "place_mismatch": { "severity": "block", "type": "situation_in_config" },
    "too_long": { "severity": "warn", "type": "word_count", "max": 15 },
    "duplicate": { "severity": "warn", "type": "duplicate_en" },
    "not_polite": {
      "severity": "warn",
      "match": "substring",
      "terms": ["gimme", "give me the", "hurry up", "right now"]
    }
  }
}
